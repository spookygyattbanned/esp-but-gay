local fonts = {}
do
    local function Register_Font(Name, Weight, Style, Asset)
        if not isfile(Asset.Id) then
            writefile(Asset.Id, Asset.Font)
        end
        if isfile(Name .. ".font") then
            delfile(Name .. ".font")
        end

        local Data = {
            name = Name,
            faces = {{
                name = "Normal",
                weight = Weight,
                style = Style,
                assetId = getcustomasset(Asset.Id),
            }},
        }
        writefile(Name .. ".font", http_service:JSONEncode(Data))
        return getcustomasset(Name .. ".font")
    end

    local ProggyTiny = Register_Font("ProggyTinyESP", 100, "Normal", {
        Id = "ProggyTinyyyy.ttf",
        Font = game:HttpGet("https://github.com/ocornut/imgui/raw/master/misc/fonts/ProggyTiny.ttf"),
    })

    fonts.main = Font.new(ProggyTiny, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
end

