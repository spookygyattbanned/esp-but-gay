function esp:get_screen_pos(world_position)
    local viewport_size = camera.ViewportSize
    local local_position = camera.CFrame:pointToObjectSpace(world_position)

    local aspect_ratio = viewport_size.X / viewport_size.Y
    local half_height = -local_position.Z * math.tan(math.rad(camera.FieldOfView / 2))
    local half_width = aspect_ratio * half_height

    local far_plane_corner = Vector3.new(-half_width, half_height, local_position.Z)
    local relative_position = local_position - far_plane_corner

    local screen_x = relative_position.X / (half_width * 2)
    local screen_y = -relative_position.Y / (half_height * 2)

    local is_on_screen = -local_position.Z > 0 and screen_x >= 0 and screen_x <= 1 and screen_y >= 0 and screen_y <= 1

    return Vector3.new(screen_x * viewport_size.X, screen_y * viewport_size.Y, -local_position.Z), is_on_screen
end

function esp:box_solve(torso)
    if not torso then
        return nil, nil, false, 0
    end

    local ViewportTop = torso.Position + (torso.CFrame.UpVector * 1.8) + camera.CFrame.UpVector
    local ViewportBottom = torso.Position - (torso.CFrame.UpVector * 2.5) - camera.CFrame.UpVector
    local Distance = (torso.Position - camera.CFrame.Position).Magnitude

    local Top, TopIsRendered = self:get_screen_pos(ViewportTop)
    local Bottom = self:get_screen_pos(ViewportBottom)

    local Width = math.max(math.floor(math.abs(Top.X - Bottom.X)), 3)
    local Height = math.max(math.floor(math.max(math.abs(Bottom.Y - Top.Y), Width / 2)), 3)
    local BoxSize = Vector2.new(math.floor(math.max(Height / 1.5, Width)), Height)
    local BoxPosition = Vector2.new(
        math.floor(Top.X * 0.5 + Bottom.X * 0.5 - BoxSize.X * 0.5),
        math.floor(math.min(Top.Y, Bottom.Y))
    )

    return BoxSize, BoxPosition, TopIsRendered, Distance
end

function esp:create(class, props)
    local ins = Instance.new(class)
    for prop, value in pairs(props) do
        ins[prop] = value
    end
    return ins
end

function esp:create_object(player)
    if player == players.LocalPlayer then return end

    local data = {
        objects = {},
        info = {
            character = nil,
            humanoid = nil,
            rootpart = nil
        },
        drawings = {}
    }
    esp[player.Name] = data
    local objects = data.objects

    objects.holder = self:create("Frame", {
        Parent = esp.screengui,
        Name = "\0",
        BackgroundTransparency = 1,
        Position = dim2(0, 0, 0, 0),
        Size = dim2(0, 0, 0, 0),
        BorderSizePixel = 0,
    })

    objects.box_outline = self:create("UIStroke", {
        Parent = (flags.Boxes and flags.Box_Type ~= "Corner" and objects.holder) or esp.cache,
        LineJoinMode = Enum.LineJoinMode.Miter
    })

    objects.box_handler = self:create("Frame", {
        Parent = (flags.Boxes and flags.Box_Type ~= "Corner" and objects.holder) or esp.cache,
        Name = "\0",
        BackgroundTransparency = 1,
        Position = dim2(0, 1, 0, 1),
        Size = dim2(1, -2, 1, -2),
        BorderSizePixel = 0,
    })

    objects.box_color = self:create("UIStroke", {
        Color = flags.Box_Color.Color,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Parent = objects.box_handler
    })

    objects.outline = self:create("Frame", {
        Parent = objects.box_handler,
        Name = "\0",
        BackgroundTransparency = 1,
        Position = dim2(0, 1, 0, 1),
        Size = dim2(1, -2, 1, -2),
        BorderSizePixel = 0,
    })

    self:create("UIStroke", {
        Parent = objects.outline,
        LineJoinMode = Enum.LineJoinMode.Miter
    })

    objects.name = self:create("TextLabel", {
        FontFace = fonts.main,
        Parent = objects.holder,
        TextColor3 = flags.Name_Color.Color,
        Text = string.format("%s (@%s)", player.DisplayName, player.Name),
        Name = "\0",
        TextStrokeTransparency = 0,
        AnchorPoint = vec2(0, 1),
        Size = dim2(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Position = dim2(0, 0, 0, -5),
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        TextSize = 9,
    })

    objects.corners = self:create("Frame", {
        Visible = true,
        Parent = (flags.Boxes and flags.Box_Type == "Corner" and objects.holder) or esp.cache,
        BackgroundTransparency = 1,
        Position = dim2(0, -1, 0, 2),
        Name = "\0",
        Size = dim2(1, 0, 1, 0),
        BorderSizePixel = 0,
    })

    local function makeCorner(parent, pos, size, anchor, rotation)
        local outline = self:create("Frame", {
            Parent = parent,
            Name = "line",
            Position = pos,
            Size = size,
            AnchorPoint = anchor or vec2(0, 0),
            Rotation = rotation or 0,
            BorderSizePixel = 0,
            BackgroundColor3 = rgb(0, 0, 0)
        })

        self:create("Frame", {
            Parent = outline,
            Position = dim2(0, 1, 0, 1),
            Size = dim2(1, -2, 1, -2),
            BorderSizePixel = 0,
            BackgroundColor3 = flags.Box_Color.Color
        })

        return outline
    end

    makeCorner(objects.corners, dim2(0, 0, 0, -2), dim2(0.4, 0, 0, 3))
    makeCorner(objects.corners, dim2(0, 0, 0, 1), dim2(0, 3, 0.25, 0))
    makeCorner(objects.corners, dim2(1, 0, 0, -2), dim2(0.4, 0, 0, 3), vec2(1, 0))
    makeCorner(objects.corners, dim2(1, 0, 0, 1), dim2(0, 3, 0.25, 0), vec2(1, 0))
    makeCorner(objects.corners, dim2(0, 0, 1, -2), dim2(0.4, 0, 0, 3), vec2(0, 1))
    makeCorner(objects.corners, dim2(0, 0, 1, -5), dim2(0, 3, 0.25, 0), vec2(0, 1), 180)
    makeCorner(objects.corners, dim2(1, 0, 1, -2), dim2(0.4, 0, 0, 3), vec2(1, 1))
    makeCorner(objects.corners, dim2(1, 0, 1, -5), dim2(0, 3, 0.25, 0), vec2(1, 1), 180)

    objects.healthbar_holder = self:create("Frame", {
        AnchorPoint = vec2(1, 0),
        Parent = flags.Healthbar and objects.holder or esp.cache,
        Name = "\0",
        Position = dim2(0, -5, 0, -1),
        Size = dim2(0, 4, 1, 2),
        BorderSizePixel = 0,
        BackgroundColor3 = rgb(0, 0, 0)
    })

    objects.healthbar = self:create("Frame", {
        Parent = objects.healthbar_holder,
        Name = "\0",
        Position = dim2(0, 1, 0, 1),
        Size = dim2(1, -2, 1, -2),
        BorderSizePixel = 0,
        BackgroundColor3 = rgb(255, 255, 255)
    })

    objects.distance = self:create("TextLabel", {
        FontFace = fonts.main,
        TextColor3 = flags.Distance_Color.Color,
        Text = "0st",
        Parent = flags.Distance and objects.holder or esp.cache,
        TextStrokeTransparency = 0,
        Name = "\0",
        Size = dim2(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Position = dim2(0, 0, 1, 5),
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        TextSize = 9,
    })

    objects.weapon = self:create("TextLabel", {
        FontFace = fonts.main,
        TextColor3 = flags.Weapon_Color.Color,
        Text = "",
        Parent = esp.cache,
        TextStrokeTransparency = 0,
        Name = "\0",
        Size = dim2(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Position = dim2(0, 0, 1, 19),
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        TextSize = 9,
    })

    for _ = 1, #bones do
        local line = Drawing.new("Line")
        line.Color = flags.Skeletons_Color.Color
        line.Thickness = 1
        line.Visible = false
        table.insert(data.drawings, line)
    end

    data.health_changed = function(value)
        if not flags.Healthbar or not data.info.humanoid then return end

        local multiplier = math.clamp(value / data.info.humanoid.MaxHealth, 0, 1)
        local color = flags.Health_Low.Color:Lerp(flags.Health_High.Color, multiplier)

        objects.healthbar.Size = UDim2.new(1, -2, multiplier, -2)
        objects.healthbar.Position = UDim2.new(0, 1, 1 - multiplier, 1)
        objects.healthbar.BackgroundColor3 = color
    end

    data.tool_added = function(item)
        if not item:IsA("Tool") then return end
        objects.weapon.Text = item.Name
        objects.weapon.Parent = (flags.Weapon and data.info.character and data.info.character:FindFirstChild(item.Name)) and objects.holder or esp.cache
    end

    data.refresh_descendants = function()
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then return end

        data.info.character = character
        data.info.humanoid = humanoid
        data.info.rootpart = character:FindFirstChild("HumanoidRootPart") or humanoid.RootPart

        humanoid.HealthChanged:Connect(data.health_changed)
        character.ChildAdded:Connect(data.tool_added)
        character.ChildRemoved:Connect(data.tool_added)

        data.health_changed(humanoid.Health)

        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            data.tool_added(tool)
        end
    end

    data.refresh_descendants()
    player.CharacterAdded:Connect(data.refresh_descendants)
end

function esp:remove_object(player)
    local data = esp[player.Name]
    if not data then return end

    for _, line in pairs(data.drawings) do
        line:Remove()
    end

    if data.objects.holder then
        data.objects.holder:Destroy()
    end

    esp[player.Name] = nil
end

function esp.refresh_elements()
    for _, v in pairs(players:GetPlayers()) do
        if v == players.LocalPlayer then continue end

        local path = esp[v.Name]
        if not path or not path.objects then continue end

        local objects = path.objects

        objects.holder.Parent = flags.Enabled and esp.screengui or esp.cache

        objects.name.Parent = flags.Names and objects.holder or esp.cache
        objects.name.TextColor3 = flags.Name_Color.Color

        local is_corner = flags.Box_Type == "Corner"

        if flags.Boxes then
            objects.corners.Parent = is_corner and objects.holder or esp.cache
            objects.box_handler.Parent = is_corner and esp.cache or objects.holder
            objects.box_outline.Parent = is_corner and esp.cache or objects.holder
        else
            objects.corners.Parent = esp.cache
            objects.box_handler.Parent = esp.cache
            objects.box_outline.Parent = esp.cache
        end

        objects.box_color.Color = flags.Box_Color.Color

        for _, corner in pairs(objects.corners:GetChildren()) do
            if corner:FindFirstChildOfClass("Frame") then
                corner:FindFirstChildOfClass("Frame").BackgroundColor3 = flags.Box_Color.Color
            end
        end

        for _, line in pairs(path.drawings) do
            line.Color = flags.Skeletons_Color.Color
            line.Visible = flags.Skeletons
        end

        objects.healthbar_holder.Parent = flags.Healthbar and objects.holder or esp.cache

        objects.weapon.TextColor3 = flags.Weapon_Color.Color
        local hasTool = v.Character and v.Character:FindFirstChildOfClass("Tool")
        objects.weapon.Parent = (flags.Weapon and hasTool) and objects.holder or esp.cache

        objects.distance.TextColor3 = flags.Distance_Color.Color
        objects.distance.Parent = flags.Distance and objects.holder or esp.cache
    end
end

esp.connection = run.RenderStepped:Connect(function()
    if not flags.Enabled then return end

    for _, player in pairs(players:GetPlayers()) do
        local data = esp[player.Name]
        if not data then continue end

        local character = data.info.character
        local humanoid = data.info.humanoid
        if not character or not humanoid or not humanoid.RootPart then continue end

        local objects = data.objects
        if not objects then continue end

        local box_size, box_pos, on_screen, distance = esp:box_solve(humanoid.RootPart)
        local holder = objects.holder

        holder.Visible = on_screen

        if flags.Skeletons and character:FindFirstChild("UpperTorso") then
            for i = 1, #bones do
                local line = data.drawings[i]
                if not line then continue end

                local origin = character:FindFirstChild(bones[i][1])
                local destination = character:FindFirstChild(bones[i][2])

                if origin and destination then
                    local origin_2d, on_start = esp:get_screen_pos(origin.Position)
                    local dest_2d, on_end = esp:get_screen_pos(destination.Position)

                    if on_start and on_end then
                        line.Visible = true
                        line.From = Vector2.new(origin_2d.X, origin_2d.Y)
                        line.To = Vector2.new(dest_2d.X, dest_2d.Y)
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        else
            for _, line in pairs(data.drawings) do
                line.Visible = false
            end
        end

        if not on_screen then continue end

        holder.Position = dim_offset(box_pos.X, box_pos.Y)
        holder.Size = dim_offset(box_size.X, box_size.Y)

        objects.distance.Text = math.round(distance) .. "st"
    end
end)

function esp:unload()
    for _, player in pairs(players:GetPlayers()) do
        self:remove_object(player)
    end

    if esp.connection then esp.connection:Disconnect() end
    if esp.player_added then esp.player_added:Disconnect() end
    if esp.player_removed then esp.player_removed:Disconnect() end

    esp.cache:Destroy()
    esp.screengui:Destroy()
    table.clear(esp)
end

for _, v in pairs(players:GetPlayers()) do
    if v ~= players.LocalPlayer then
        esp:create_object(v)
    end
end

esp.player_added = players.PlayerAdded:Connect(function(v)
    esp:create_object(v)
end)

esp.player_removed = players.PlayerRemoving:Connect(function(v)
    esp:remove_object(v)
end)

task.wait()
esp.refresh_elements()
